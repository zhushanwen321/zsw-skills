#!/bin/sh
# zsw-skills pre-commit
# 启用：git config core.hooksPath .githooks
#
# 段 1：dev-workflow 双平台 workflow 构建一致性 + 对账
# workflows/src/ 是单源（壳×2 + 公共体），产物由 scripts/build-workflows.mjs 生成；
# 改源忘 build、或绕过源直接改产物 → 这里拦截

STAGED=$(git diff --cached --name-only --diff-filter=ACMR -- 'skills/self/dev-workflow/workflows/' 'scripts/build-workflows.mjs' 'scripts/check-workflow-types.mjs' 'scripts/check-commit-contract.mjs' 'scripts/wf-facade.d.ts')
if [ -n "$STAGED" ]; then
  echo "pre-commit[workflow-build]: staged 变更含 workflow 源/产物，跑构建一致性检查…"
  node scripts/build-workflows.mjs --check || {
    echo ""
    echo "[workflow-build] 产物与源不一致。恢复动作：node scripts/build-workflows.mjs 重新生成后再提交"
    exit 1
  }
  node scripts/check-workflow-parity.mjs || {
    echo ""
    echo "[workflow-parity] 双平台产物出现未登记差异（处理见上）。"
    echo "  恢复动作：改 src/ 单源后重新 build，不要直接改产物"
    exit 1
  }
  node scripts/check-workflow-types.mjs || {
    echo ""
    echo "[workflow-types] zcode 产物类型检查未过（真实平台 facade 口径）。"
    echo "  恢复动作：修 src/ 单源至类型绿后重新 build 再提交"
    exit 1
  }
  # 提交契约往返测试（渲染 ↔ 反查两份实现钉同一条真实往返）：仅 wave-executor 相关时触发
  WAVE_STAGED=$(echo "$STAGED" | grep 'wave-executor' || true)
  if [ -n "$WAVE_STAGED" ]; then
    node scripts/check-commit-contract.mjs || {
      echo ""
      echo "[commit-contract] 提交说明结构契约往返测试失败。"
      echo "  恢复动作：同步修改 wave-executor.shared.ts 的 buildCommitMessage 与 RECONCILE_STATUS 后重新 build"
      exit 1
    }
  fi
fi

# 段 2：断言路径文字匹配防回潮（2026-11-04 结构化断言改造配套）
# workflow 单源新增 .includes/.test/indexOf 命中点必须归类：保留区更新基线并写明理由，
# 证据扫描改结构化判定——脚本自身给出处置指引
ASSERT_STAGED=$(git diff --cached --name-only --diff-filter=ACMR -- 'skills/self/dev-workflow/workflows/src/' 'scripts/text-assertion-baseline.json')
if [ -n "$ASSERT_STAGED" ]; then
  echo "pre-commit[text-assertion]: staged 变更含 workflow 单源，跑文字匹配防回潮检查…"
  node scripts/check-no-text-assertion.mjs || exit 1
fi

# 段 3：技能版本纪律（AX3 强制器：bump 对账 + 共享源按产物 diff 联动 + 产物版本戳一致性）
# 判定对象 = git 索引（本次提交内容与 HEAD 的差异）；触技能自有文件 / 共享构建源 / 产物时
# 检查。检查器逐条输出「违规 → 权威源 → 恢复动作」，此处只给总处置提示。过滤器覆盖
# dev-workflow 全树 + archived/（检查器只登记现行技能，归档改动恒放行；宽前缀防技能
# 目录改名后再漏检——曾因旧目录名过滤器全部失效）
VERSION_STAGED=$(git diff --cached --name-only --diff-filter=ACMRD -- 'skills/self/dev-workflow/' 'archived/')
if [ -n "$VERSION_STAGED" ]; then
  echo "pre-commit[version-discipline]: staged 变更含技能自有文件 / 共享构建源 / 产物，跑版本纪律检查…"
  node scripts/check-version-discipline.mjs || {
    echo ""
    echo "[version-discipline] 技能版本纪律未过（逐条恢复动作见上方）。"
    echo "  恢复动作：按上方提示 bump 对应 SKILL.md frontmatter version；产物变化时重跑 node scripts/build-workflows.mjs 后重新 git add 再提"
    exit 1
  }
fi

# 段 4：check-exec-plan 差分测试（移植侧与 W2 引擎同源防漂移）
# check-exec-plan.mjs 的 schema 主段是 wave-executor validatePlan 的 JS 移植（错误文案逐字
# 一致），改任一侧（共享源 / 构建产物 / 移植脚本 / 差分测试自身）必须过差分对账。
# 差分锚定 dev-flow-v5；dev/v4 的移植脚本同族，一并纳入触发
EXEC_STAGED=$(git diff --cached --name-only --diff-filter=ACMR -- 'skills/self/dev-workflow/workflows/src/wave-executor*.shared.ts' 'skills/self/dev-workflow/workflows/pi/wave-executor*.js' 'skills/self/dev-workflow/dev-flow-v5/scripts/check-exec-plan.mjs' 'skills/self/dev-workflow/dev-flow-v4/scripts/check-exec-plan.mjs' 'skills/self/dev-workflow/dev-flow-dev/scripts/check-exec-plan.mjs' 'scripts/tests/check-exec-plan-parity.test.mjs')
if [ -n "$EXEC_STAGED" ]; then
  echo "pre-commit[exec-plan-parity]: staged 变更含 validatePlan 共享源 / 产物 / 移植侧，跑差分测试…"
  node --test scripts/tests/check-exec-plan-parity.test.mjs || {
    echo ""
    echo "[exec-plan-parity] check-exec-plan 与 wave-executor validatePlan 差分测试失败。"
    echo "  恢复动作：同步修改 skills/self/dev-workflow/dev-flow-v5/scripts/check-exec-plan.mjs 与"
    echo "  workflows/src/wave-executor-v5.shared.ts 的同源段（错误文案逐字一致）→ node scripts/build-workflows.mjs"
    echo "  → node --test scripts/tests/check-exec-plan-parity.test.mjs 绿后重新 git add"
    exit 1
  }
fi

exit 0
