{
  "//": "delivery-v5 内核规则唯一权威（数据不是文档）。五域转移表 + 预算 + 护栏 + 谓词词表。静态校验：node delivery-core.mjs validate（无环除修复回边 / 状态可达 / 转移执行器唯一 / 谓词在词表 / 角色在词表）。改本文件必须跑校验器与 scripts/tests/delivery-core-v5.test.mjs。",
  "actors": [
    "designer",
    "builder",
    "assurance",
    "user",
    "engine",
    "main-agent"
  ],
  "budgets": {
    "//": "上限取值是初始经验值（设计文档 §5 风险条目），实跑校准后调整。workflow 源码内嵌的同名常量由 delivery-core-v5.test.mjs 对拍本表。",
    "repairPerVersionCap": 3,
    "uniqueMustFixCap": 10,
    "assuranceCrossRunCap": 6,
    "t2RewriteAttemptCap": 2,
    "d2ItemReflowCap": 2,
    "acceptanceReReviewRoundCap": 6,
    "findingRegradeHalt": 2
  },
  "guardrails": {
    "//": "FindingRaised 登记护栏（delivery-gate append 写入当时执行）。",
    "boundaryBanOnAssertedRequirements": true,
    "consequenceRefutationRequired": true,
    "regradeHaltEnabled": true
  },
  "predicates": {
    "//": "转移前置谓词词表。decider = 谁机器判定：gate = delivery-gate 命令、core = delivery-core 命令、workflow = 执行 workflow、user = 用户动作本身。",
    "userConfirmation": {
      "decider": "user"
    },
    "verificationOnly": {
      "decider": "gate"
    },
    "requireDesignApproved": {
      "decider": "gate"
    },
    "d3Passed": {
      "decider": "workflow",
      "note": "dev-flow-v5 D3 验收全绿（W2 第二实例化终态 completed）"
    },
    "allIncrementsImplemented": {
      "decider": "gate"
    },
    "schema2": {
      "decider": "gate"
    },
    "schema1": {
      "decider": "gate"
    },
    "explorationDue": {
      "decider": "core",
      "note": "delivery-core exploration-due（kernel-judgments 单源）"
    },
    "mustFixOpenZero": {
      "decider": "core",
      "note": "delivery-core open-findings（kernel-judgments 单源）"
    },
    "openMustFixPositive": {
      "decider": "core"
    },
    "assuranceCompleted": {
      "decider": "gate"
    },
    "budgetPerVersionAvailable": {
      "decider": "core",
      "note": "delivery-core repair-budget"
    },
    "budgetCrossRunAvailable": {
      "decider": "gate"
    },
    "uniqueMustFixCapExceeded": {
      "decider": "gate"
    },
    "driftDetected": {
      "decider": "gate"
    },
    "baselineConfirmed": {
      "decider": "user"
    },
    "verdictAccepted": {
      "decider": "gate"
    },
    "userRiskAcceptance": {
      "decider": "user",
      "note": "accept-risk 绑 gapId"
    },
    "versionIncrementApproved": {
      "decider": "user"
    },
    "commitReceipt": {
      "decider": "workflow",
      "note": "W2 commit 门禁回执"
    },
    "reasonProvided": {
      "decider": "core"
    },
    "basisProvided": {
      "decider": "core"
    },
    "preauthorizedOrExplicit": {
      "decider": "gate"
    },
    "artifactUsable": {
      "decider": "core",
      "note": "在盘 + artifactSha256 一致"
    },
    "criterionChanged": {
      "decider": "core",
      "note": "最近批准 seq 晚于最新可用探索"
    }
  },
  "domains": {
    "task": {
      "initial": "intent-declared",
      "states": [
        "intent-declared",
        "acceptance-drafting",
        "acceptance-reviewed",
        "acceptance-approved",
        "design",
        "implementing",
        "candidate-formed",
        "candidate-explored",
        "implementation-recorded",
        "assuring",
        "repairing",
        "finalizing",
        "candidate",
        "accepted",
        "accepted_with_risk",
        "process-failed",
        "revision-unstable",
        "supersede-pending",
        "superseded",
        "supersede-cancelled"
      ],
      "terminalStates": [
        "accepted",
        "accepted_with_risk",
        "process-failed",
        "superseded",
        "supersede-cancelled"
      ],
      "transitions": [
        {
          "from": "intent-declared",
          "to": "acceptance-drafting",
          "event": "acceptance-design-start",
          "requires": [],
          "executor": "acceptance-design-v5",
          "actor": "designer"
        },
        {
          "from": "acceptance-drafting",
          "to": "acceptance-reviewed",
          "event": "AcceptanceReviewed",
          "requires": [
            "userConfirmation"
          ],
          "executor": "delivery-gate record-review",
          "actor": "assurance"
        },
        {
          "from": "acceptance-reviewed",
          "to": "acceptance-approved",
          "event": "AcceptanceApproved",
          "requires": [
            "userConfirmation"
          ],
          "executor": "delivery-gate approve-acceptance",
          "actor": "user"
        },
        {
          "from": "acceptance-approved",
          "to": "design",
          "event": "route-design",
          "requires": [
            "requireDesignApproved"
          ],
          "executor": "tech-design-v5",
          "actor": "designer"
        },
        {
          "from": "design",
          "to": "implementing",
          "event": "DesignApproved",
          "requires": [
            "userConfirmation"
          ],
          "executor": "delivery-gate record-design-approved",
          "actor": "user"
        },
        {
          "from": "acceptance-approved",
          "to": "implementing",
          "event": "route-build",
          "requires": [
            "verificationOnly"
          ],
          "executor": "dev-flow-v5",
          "actor": "main-agent"
        },
        {
          "from": "implementing",
          "to": "candidate-formed",
          "event": "d3-passed",
          "requires": [
            "d3Passed",
            "allIncrementsImplemented"
          ],
          "executor": "dev-flow-v5 D3",
          "actor": "engine"
        },
        {
          "from": "candidate-formed",
          "to": "candidate-explored",
          "event": "explore-only",
          "requires": [
            "schema2",
            "explorationDue"
          ],
          "executor": "independent-assurance-v5 --mode explore-only",
          "actor": "assurance",
          "note": "V4 实跑死锁点：本转移不得要求 ImplementationRecorded 先行（探索先于 D4 登记）"
        },
        {
          "from": "implementing",
          "to": "candidate-explored",
          "event": "explore-only",
          "requires": [
            "schema2",
            "explorationDue",
            "d3Passed"
          ],
          "executor": "independent-assurance-v5 --mode explore-only",
          "actor": "assurance",
          "note": "V4 实跑死锁点的机器化否定：探索通道在增量登记前即合法（d3Passed 由 dev-flow status 判定）；与 candidate-formed 边同执行器不同前置状态"
        },
        {
          "from": "candidate-formed",
          "to": "implementation-recorded",
          "event": "register-implementation",
          "requires": [
            "schema1",
            "mustFixOpenZero"
          ],
          "executor": "dev-flow-v5 D4",
          "actor": "builder"
        },
        {
          "from": "candidate-explored",
          "to": "implementation-recorded",
          "event": "register-implementation",
          "requires": [
            "mustFixOpenZero"
          ],
          "executor": "dev-flow-v5 D4",
          "actor": "builder"
        },
        {
          "from": "implementation-recorded",
          "to": "assuring",
          "event": "assurance-start",
          "requires": [],
          "executor": "independent-assurance-v5 --mode full",
          "actor": "assurance"
        },
        {
          "from": "assuring",
          "to": "finalizing",
          "event": "AssuranceCompleted",
          "requires": [
            "assuranceCompleted"
          ],
          "executor": "independent-assurance-v5",
          "actor": "assurance"
        },
        {
          "from": "assuring",
          "to": "repairing",
          "event": "repair-start",
          "requires": [
            "openMustFixPositive",
            "budgetPerVersionAvailable",
            "budgetCrossRunAvailable"
          ],
          "executor": "assurance-repair-loop-v5",
          "actor": "builder"
        },
        {
          "from": "repairing",
          "to": "assuring",
          "event": "RepairRoundRecorded",
          "requires": [
            "budgetPerVersionAvailable",
            "budgetCrossRunAvailable"
          ],
          "executor": "assurance-repair-loop-v5",
          "actor": "builder",
          "backedge": "repair"
        },
        {
          "from": "finalizing",
          "to": "candidate",
          "event": "evaluate",
          "requires": [],
          "executor": "delivery-gate evaluate",
          "actor": "main-agent"
        },
        {
          "from": "candidate",
          "to": "accepted",
          "event": "evaluate",
          "requires": [
            "verdictAccepted"
          ],
          "executor": "delivery-gate evaluate",
          "actor": "main-agent"
        },
        {
          "from": "candidate",
          "to": "accepted_with_risk",
          "event": "accept-risk",
          "requires": [
            "userRiskAcceptance"
          ],
          "executor": "delivery-gate accept-risk",
          "actor": "user"
        },
        {
          "from": "revision-unstable",
          "to": "implementing",
          "event": "RevisionBaselineConfirmed",
          "requires": [
            "baselineConfirmed"
          ],
          "executor": "delivery-gate confirm-baseline",
          "actor": "user",
          "backedge": "repair"
        },
        {
          "from": "*",
          "to": "revision-unstable",
          "event": "drift-detected",
          "requires": [
            "driftDetected"
          ],
          "executor": "delivery-gate evaluate",
          "actor": "engine"
        },
        {
          "from": "*",
          "to": "process-failed",
          "event": "budget-exhausted",
          "requires": [
            "uniqueMustFixCapExceeded"
          ],
          "executor": "delivery-gate evaluate",
          "actor": "engine",
          "note": "含 perVersion>3 与 crossRun>6 两档预算耗尽，停回用户"
        },
        {
          "from": "*",
          "to": "supersede-pending",
          "event": "supersede-prepare",
          "requires": [
            "userConfirmation"
          ],
          "executor": "delivery-gate supersede-prepare",
          "actor": "user"
        },
        {
          "from": "supersede-pending",
          "to": "superseded",
          "event": "supersede-commit",
          "requires": [
            "userConfirmation"
          ],
          "executor": "delivery-gate supersede-commit",
          "actor": "user"
        },
        {
          "from": "supersede-pending",
          "to": "supersede-cancelled",
          "event": "supersede-cancel",
          "requires": [
            "userConfirmation"
          ],
          "executor": "delivery-gate supersede-cancel",
          "actor": "user"
        }
      ]
    },
    "node": {
      "initial": "pending",
      "states": [
        "pending",
        "in-progress",
        "done",
        "blocked",
        "failed",
        "suspended"
      ],
      "terminalStates": [],
      "transitions": [
        {
          "from": "pending",
          "to": "in-progress",
          "event": "begin",
          "requires": [],
          "executor": "wave-executor-v5",
          "actor": "engine",
          "effect": "attempts+1（派发即计数；V4 缺陷修复：begin 原地归零使修复环保留的计数丢失）"
        },
        {
          "from": "in-progress",
          "to": "done",
          "event": "finish-done",
          "requires": [
            "commitReceipt"
          ],
          "executor": "wave-executor-v5",
          "actor": "engine",
          "effect": "attempts 保留（下限 1）"
        },
        {
          "from": "in-progress",
          "to": "blocked",
          "event": "block",
          "requires": [
            "reasonProvided"
          ],
          "executor": "wave-executor-v5",
          "actor": "engine",
          "effect": "attempts 保留（begin 已计数）"
        },
        {
          "from": "in-progress",
          "to": "failed",
          "event": "fail",
          "requires": [
            "reasonProvided"
          ],
          "executor": "wave-executor-v5",
          "actor": "engine",
          "effect": "attempts 保留（begin 已计数）"
        },
        {
          "from": "blocked",
          "to": "pending",
          "event": "reset",
          "requires": [],
          "executor": "wave-executor-v5 失败修复环",
          "actor": "engine",
          "backedge": "repair",
          "effect": "attempts 保留（下一次 begin 再 +1；V4 在此 +1 且 begin 归零 = 双写竞争）"
        },
        {
          "from": "failed",
          "to": "pending",
          "event": "reset",
          "requires": [],
          "executor": "wave-executor-v5 失败修复环",
          "actor": "engine",
          "backedge": "repair",
          "effect": "attempts 保留（下一次 begin 再 +1；V4 在此 +1 且 begin 归零 = 双写竞争）"
        },
        {
          "from": "pending",
          "to": "suspended",
          "event": "suspend",
          "requires": [],
          "executor": "wave-executor-v5 终局回写",
          "actor": "engine",
          "effect": "attempts 保留"
        },
        {
          "from": "suspended",
          "to": "pending",
          "event": "resume",
          "requires": [],
          "executor": "wave-executor-v5 断点恢复",
          "actor": "engine",
          "backedge": "lifecycle"
        },
        {
          "from": "done",
          "to": "pending",
          "event": "reconcile-pending",
          "requires": [],
          "executor": "wave-executor-v5 恢复对账",
          "actor": "engine",
          "note": "标 done 无 commit → 以 git 为准回退",
          "backedge": "repair",
          "effect": "attempts 保留（V4 缺陷修复：原归零丢计数）"
        },
        {
          "from": "pending",
          "to": "done",
          "event": "reconcile-done",
          "requires": [
            "commitReceipt"
          ],
          "executor": "wave-executor-v5 恢复对账",
          "actor": "engine",
          "note": "git log 反查命中补写",
          "effect": "attempts = max(1, prior+1)（补记 git 中发现的一次未记账完成派发）"
        },
        {
          "from": "blocked",
          "to": "done",
          "event": "manual-disposition",
          "requires": [
            "basisProvided"
          ],
          "executor": "delivery-core node-transition",
          "actor": "main-agent",
          "note": "显式人工处置转移（V4 词表外事件的合法化通道），basis 必填并留痕"
        },
        {
          "from": "failed",
          "to": "done",
          "event": "manual-disposition",
          "requires": [
            "basisProvided"
          ],
          "executor": "delivery-core node-transition",
          "actor": "main-agent"
        },
        {
          "from": "suspended",
          "to": "done",
          "event": "manual-disposition",
          "requires": [
            "basisProvided"
          ],
          "executor": "delivery-core node-transition",
          "actor": "main-agent"
        }
      ]
    },
    "finding": {
      "initial": "open",
      "states": [
        "open",
        "resolved",
        "reaffirmed",
        "risk-accepted"
      ],
      "terminalStates": [],
      "transitions": [
        {
          "from": "open",
          "to": "resolved",
          "event": "FindingResolved",
          "requires": [],
          "executor": "assurance-repair-loop-v5",
          "actor": "assurance",
          "note": "仅在当前裁决 revision 关闭；revision 前进即失效"
        },
        {
          "from": "open",
          "to": "reaffirmed",
          "event": "ResolutionReaffirmed",
          "requires": [],
          "executor": "independent-assurance-v5",
          "actor": "assurance",
          "note": "重认领：新 revision 上确认原修复仍有效"
        },
        {
          "from": "open",
          "to": "risk-accepted",
          "event": "RiskAccepted",
          "requires": [
            "preauthorizedOrExplicit"
          ],
          "executor": "delivery-gate accept-risk",
          "actor": "user"
        },
        {
          "from": "resolved",
          "to": "open",
          "event": "reopen",
          "requires": [
            "criterionChanged"
          ],
          "executor": "delivery-gate append FindingRaised(reopenOf)",
          "actor": "assurance",
          "backedge": "repair",
          "note": "revision 失效或探索重开；reopenOf 根去重不重复计数"
        },
        {
          "from": "reaffirmed",
          "to": "open",
          "event": "reopen",
          "requires": [
            "criterionChanged"
          ],
          "executor": "delivery-gate append FindingRaised(reopenOf)",
          "actor": "assurance",
          "backedge": "repair"
        },
        {
          "from": "risk-accepted",
          "to": "open",
          "event": "reopen",
          "requires": [
            "criterionChanged"
          ],
          "executor": "delivery-gate append FindingRaised(reopenOf)",
          "actor": "assurance",
          "backedge": "repair"
        }
      ]
    },
    "exploration": {
      "initial": "none",
      "states": [
        "none",
        "usable",
        "stale"
      ],
      "terminalStates": [],
      "transitions": [
        {
          "from": "none",
          "to": "usable",
          "event": "ExplorationCompleted",
          "requires": [
            "artifactUsable"
          ],
          "executor": "independent-assurance-v5 --mode explore-only|full",
          "actor": "assurance"
        },
        {
          "from": "stale",
          "to": "usable",
          "event": "ExplorationCompleted",
          "requires": [
            "artifactUsable"
          ],
          "executor": "independent-assurance-v5",
          "actor": "assurance",
          "backedge": "repair"
        },
        {
          "from": "usable",
          "to": "stale",
          "event": "invalidate",
          "requires": [
            "criterionChanged"
          ],
          "executor": "delivery-gate evaluate（推导）",
          "actor": "engine",
          "note": "验收批准/方案批准晚于探索 → 证据失效重取"
        }
      ]
    },
    "acceptance-package": {
      "initial": "drafting",
      "states": [
        "drafting",
        "frozen",
        "opened"
      ],
      "terminalStates": [],
      "notes": [
        "tamper-detected 不是转移：非法写入被 chmod 拒绝或加载时检出，恢复动作 = open-revision 合法通道或从 frozen 快照恢复"
      ],
      "transitions": [
        {
          "from": "drafting",
          "to": "frozen",
          "event": "AcceptanceApproved",
          "requires": [
            "userConfirmation"
          ],
          "executor": "delivery-gate approve-acceptance",
          "actor": "user",
          "effect": "chmod 0444 + 快照 frozen/v<N>/（写入当时防护）"
        },
        {
          "from": "frozen",
          "to": "opened",
          "event": "RevisionOpened",
          "requires": [
            "versionIncrementApproved"
          ],
          "executor": "delivery-gate open-revision",
          "actor": "user",
          "effect": "chmod 0644 解锁起草",
          "backedge": "repair"
        },
        {
          "from": "opened",
          "to": "drafting",
          "event": "redraft",
          "requires": [],
          "executor": "acceptance-design-v5",
          "actor": "designer"
        }
      ]
    }
  }
}
