{
  "//": "delivery-v6 内核规则唯一权威（数据不是文档）。五域转移表 + 预算 + 护栏 + 谓词词表。静态校验：node delivery-core.mjs validate（无环除修复回边 / 状态可达 / 转移执行器唯一 / 谓词在词表 / 角色在词表）。改本文件必须跑校验器与 scripts/tests/delivery-core-v6.test.mjs。",
  "actors": [
    "designer",
    "builder",
    "assurance",
    "user",
    "engine",
    "main-agent"
  ],
  "budgets": {
    "//": "上限取值是初始经验值（设计文档 §5 风险条目），实跑校准后调整。workflow 源码内嵌的同名常量由 delivery-core-v6.test.mjs 对拍本表。",
    "//loopAttempts": "循环尝试预算（loop-attempts.jsonl，按 started 事件计数）：当前仅 acceptance-review 接入（键映射在 kernel-judgments.LOOP_BUDGET_CAP_KEYS 单源）；其余循环未接入属已知缺口，不得宣称已有统一上界。登记经 delivery-core loop-attempt；读取经 delivery-core loop-budget。",
    "//acceptanceReReviewRoundCap": "验收复审预算：按 loop-attempts.jsonl 中 loop=acceptance-review 的 started 事件计数（跨 run 累计，打回/校验失败/中断均计入；同 (attemptKey,event) 幂等去重），超上限 evaluate 判 process-failed。不再按成功登记的 AcceptanceReviewed 计数——那只覆盖通过路径，漏掉主要失败路径（设计 §2.4）。",
    "repairPerVersionCap": 3,
    "uniqueMustFixCap": 10,
    "assuranceCrossRunCap": 6,
    "t2RewriteAttemptCap": 2,
    "d2ItemReflowCap": 2,
    "acceptanceReReviewRoundCap": 6,
    "findingRegradeHalt": 2,
    "aggregateRegradeHalt": 2
  },
  "guardrails": {
    "//": "FindingRaised 登记护栏（delivery-gate 事件写入（appendEvent）当时执行）。gate 源码读取的全部 guardrails 键必须在此显式登记（键集对拍见 delivery-core-v6.test.mjs）。注意：本节键是护栏登记不是运行时开关——V5 设计确立的护栏（如 consequenceRefutation 强制）语义上不可关闭，gate 端硬编码执行，登记只为数据权威完整；未来新增真正可配置的护栏时才允许 gate 按 false 跳过。",
    "boundaryBanOnAssertedRequirements": true,
    "consequenceRefutationRequired": true,
    "regradeHaltEnabled": true,
    "emptyScopeBoundaryRequiresRefutation": true,
    "documentation": {
      "//": "护栏判据前置登记（scripts/check-gate-prompt-parity.mjs 对账 2 的输入源）：每条登记 keywords（判据核心词，任一命中即算在场）与 requiredIn（必须写明该判据的消费方文件，仓库相对路径）。本块只做结构性检查——关键词命中不等于判据语义到位，判据措辞变化时同步维护关键词。authorityRefutationRequired 是 gate 硬编码护栏（无本开关键），仅作 documentation 条目登记。",
      "boundaryBanOnAssertedRequirements": {
        "keywords": ["断言级判据", "断言覆盖"],
        "requiredIn": [
          "skills/self/dev-workflow/delivery-v6/references/roles/explorer.md",
          "skills/self/dev-workflow/delivery-v6/references/roles/builder.md",
          "skills/self/dev-workflow/delivery-v6/references/roles/coverage-reviewer.md",
          "skills/self/dev-workflow/workflows/src/candidate-build-v6.shared.ts",
          "skills/self/dev-workflow/workflows/src/independent-assurance-v6.shared.ts",
          "skills/self/dev-workflow/workflows/src/assurance-repair-loop-v6.shared.ts"
        ]
      },
      "emptyScopeBoundaryRequiresRefutation": {
        "keywords": ["empty-scope-refutation", "emptyScopeRefutation"],
        "requiredIn": [
          "skills/self/dev-workflow/workflows/src/candidate-build-v6.shared.ts",
          "skills/self/dev-workflow/workflows/src/independent-assurance-v6.shared.ts",
          "skills/self/dev-workflow/workflows/src/assurance-repair-loop-v6.shared.ts"
        ]
      },
      "regradeHaltEnabled": {
        "keywords": ["定级熔断", "定级改判", "定级组合"],
        "requiredIn": [
          "skills/self/dev-workflow/workflows/src/independent-assurance-v6.shared.ts",
          "skills/self/dev-workflow/workflows/src/assurance-repair-loop-v6.shared.ts"
        ]
      },
      "consequenceRefutationRequired": {
        "keywords": ["consequenceRefutation", "consequence-refutation", "行为后果否证"],
        "requiredIn": [
          "skills/self/dev-workflow/delivery-v6/references/roles/explorer.md",
          "skills/self/dev-workflow/workflows/src/candidate-build-v6.shared.ts",
          "skills/self/dev-workflow/workflows/src/independent-assurance-v6.shared.ts",
          "skills/self/dev-workflow/workflows/src/assurance-repair-loop-v6.shared.ts"
        ]
      },
      "authorityRefutationRequired": {
        "keywords": ["--authority-backed", "authorityBacked"],
        "requiredIn": [
          "skills/self/dev-workflow/workflows/src/candidate-build-v6.shared.ts",
          "skills/self/dev-workflow/workflows/src/independent-assurance-v6.shared.ts",
          "skills/self/dev-workflow/workflows/src/assurance-repair-loop-v6.shared.ts"
        ]
      }
    }
  },
  "predicates": {
    "//": "转移前置谓词词表。decider = 谁机器判定：gate = delivery-gate 命令、core = delivery-core 命令、workflow = 执行 workflow、user = 用户动作本身。",
    "userConfirmation": {
      "decider": "user"
    },
    "verificationOnly": {
      "decider": "gate"
    },
    "requireDesignApproved": {
      "decider": "gate"
    },
    "d3Passed": {
      "decider": "workflow",
      "note": "dev-flow-v6 D3 验收全绿（W2 第二实例化终态 completed）"
    },
    "allIncrementsImplemented": {
      "decider": "gate"
    },
    "schema2": {
      "decider": "gate"
    },
    "schema1": {
      "decider": "gate"
    },
    "explorationDue": {
      "decider": "core",
      "note": "delivery-core exploration-due（kernel-judgments 单源）"
    },
    "mustFixOpenZero": {
      "decider": "core",
      "note": "delivery-core open-findings（kernel-judgments 单源）"
    },
    "openMustFixPositive": {
      "decider": "core"
    },
    "assuranceCompleted": {
      "decider": "gate"
    },
    "budgetPerVersionAvailable": {
      "decider": "core",
      "note": "delivery-core repair-budget"
    },
    "budgetCrossRunAvailable": {
      "decider": "gate"
    },
    "uniqueMustFixCapExceeded": {
      "decider": "gate"
    },
    "driftDetected": {
      "decider": "gate"
    },
    "baselineConfirmed": {
      "decider": "user"
    },
    "verdictAccepted": {
      "decider": "gate"
    },
    "userRiskAcceptance": {
      "decider": "user",
      "note": "accept-risk 绑 gapId"
    },
    "versionIncrementApproved": {
      "decider": "user"
    },
    "commitReceipt": {
      "decider": "workflow",
      "note": "W2 commit 门禁回执"
    },
    "reasonProvided": {
      "decider": "core"
    },
    "basisProvided": {
      "decider": "core"
    },
    "preauthorizedOrExplicit": {
      "decider": "gate"
    },
    "artifactUsable": {
      "decider": "core",
      "note": "在盘 + artifactSha256 一致"
    },
    "criterionChanged": {
      "decider": "core",
      "note": "按域双语义，均在内核单源实现：exploration 域 = delivery-core exploration-due（最近批准 seq 晚于最新可用探索）；finding 域 = kernel-judgments.criterionChangedSinceResolution（finding 最近一次解决时验收版本 ≠ 当前裁决版本）"
    }
  },
  "writeDomains": {
    "//": "写入目标域词表（gate 事件写入按「角色 × 当前状态 × 目标域」矩阵裁决）。process 域不在矩阵内 = 签名事件流不可写（过程记录走独立观测流，读侧合流见 delivery-core events）。",
    "values": ["acceptance", "design", "implementation", "evidence", "finding", "decision", "process"]
  },
  "eventDomains": {
    "//": "事件类型 → 写入目标域。gate 在 appendEvent 写入时盖 domain 章（读侧对无章历史事件按本表补判）。键词表与 gate EVENT_SCHEMAS 的一致性由 scripts/tests/delivery-core-v6.test.mjs 对账（避免双源）。",
    "acceptance": ["AcceptanceReviewed", "AcceptanceApproved", "RevisionOpened"],
    "design": ["DesignApproved"],
    "implementation": ["ImplementationRecorded", "RepairRoundRecorded"],
    "evidence": ["EvidenceRecorded", "ExplorationCompleted", "AssuranceCompleted", "AssuranceRevisionDrift"],
    "finding": ["FindingRaised", "FindingResolved", "ResolutionReaffirmed"],
    "decision": [
      "RiskAccepted",
      "RiskPreauthorized",
      "PolicyUpgraded",
      "RevisionBaselineConfirmed",
      "IndependentTaskDeclared",
      "TaskSuperseded",
      "TaskSupersedeCancelled",
      "ExternalAuthorityDeclared",
      "EnvironmentBaselineConfirmed"
    ]
  },
  "writeMatrix": {
    "//": "「角色 × 当前状态 × 目标域」写入矩阵（appendEvent 统一执行）。states 用 kernel-judgments taskPhaseFromEvents 的任务阶段词表（task 域状态）；'*' = 任意阶段。缺行 = 拒绝写入。初始数据 states 全 '*'（阶段维先立机制，取值待实跑证据再收紧——防新死锁优先于收紧）。",
    "rows": [
      { "actor": "builder", "domain": "implementation", "states": ["*"] },
      { "actor": "builder", "domain": "finding", "states": ["*"] },
      { "actor": "assurance", "domain": "evidence", "states": ["*"] },
      { "actor": "assurance", "domain": "finding", "states": ["*"] },
      { "actor": "assurance", "domain": "acceptance", "states": ["*"] },
      { "actor": "user", "domain": "acceptance", "states": ["*"] },
      { "actor": "user", "domain": "design", "states": ["*"] },
      { "actor": "user", "domain": "decision", "states": ["*"] }
    ]
  },
  "domains": {
    "task": {
      "initial": "intent-declared",
      "states": [
        "intent-declared",
        "acceptance-drafting",
        "acceptance-reviewed",
        "acceptance-approved",
        "design",
        "implementing",
        "candidate-formed",
        "candidate-explored",
        "implementation-recorded",
        "assuring",
        "repairing",
        "finalizing",
        "candidate",
        "accepted",
        "accepted_with_risk",
        "process-failed",
        "revision-unstable",
        "supersede-pending",
        "superseded",
        "supersede-cancelled"
      ],
      "terminalStates": [
        "accepted",
        "accepted_with_risk",
        "process-failed",
        "superseded",
        "supersede-cancelled"
      ],
      "transitions": [
        {
          "from": "intent-declared",
          "to": "acceptance-drafting",
          "event": "acceptance-design-start",
          "requires": [],
          "executor": "acceptance-design-v6",
          "actor": "designer"
        },
        {
          "from": "acceptance-drafting",
          "to": "acceptance-reviewed",
          "event": "AcceptanceReviewed",
          "requires": [
            "userConfirmation"
          ],
          "executor": "delivery-gate record-review",
          "actor": "assurance"
        },
        {
          "from": "acceptance-reviewed",
          "to": "acceptance-approved",
          "event": "AcceptanceApproved",
          "requires": [
            "userConfirmation"
          ],
          "executor": "delivery-gate approve-acceptance",
          "actor": "user"
        },
        {
          "from": "acceptance-approved",
          "to": "design",
          "event": "route-design",
          "requires": [
            "requireDesignApproved"
          ],
          "executor": "tech-design-v6",
          "actor": "designer"
        },
        {
          "from": "design",
          "to": "implementing",
          "event": "DesignApproved",
          "requires": [
            "userConfirmation"
          ],
          "executor": "delivery-gate record-design-approved",
          "actor": "user"
        },
        {
          "from": "acceptance-approved",
          "to": "implementing",
          "event": "route-build",
          "requires": [
            "verificationOnly"
          ],
          "executor": "dev-flow-v6",
          "actor": "main-agent"
        },
        {
          "from": "implementing",
          "to": "candidate-formed",
          "event": "d3-passed",
          "requires": [
            "d3Passed",
            "allIncrementsImplemented"
          ],
          "executor": "dev-flow-v6 D3",
          "actor": "engine"
        },
        {
          "from": "candidate-formed",
          "to": "candidate-explored",
          "event": "explore-only",
          "requires": [
            "schema2",
            "explorationDue"
          ],
          "executor": "independent-assurance-v6 --mode explore-only",
          "actor": "assurance",
          "note": "V4 实跑死锁点：本转移不得要求 ImplementationRecorded 先行（探索先于 D4 登记）"
        },
        {
          "from": "implementing",
          "to": "candidate-explored",
          "event": "explore-only",
          "requires": [
            "schema2",
            "explorationDue",
            "d3Passed"
          ],
          "executor": "independent-assurance-v6 --mode explore-only",
          "actor": "assurance",
          "note": "V4 实跑死锁点的机器化否定：探索通道在增量登记前即合法（d3Passed 由 dev-flow status 判定）；与 candidate-formed 边同执行器不同前置状态"
        },
        {
          "from": "candidate-formed",
          "to": "implementation-recorded",
          "event": "register-implementation",
          "requires": [
            "schema1",
            "mustFixOpenZero"
          ],
          "executor": "dev-flow-v6 D4",
          "actor": "builder"
        },
        {
          "from": "candidate-explored",
          "to": "implementation-recorded",
          "event": "register-implementation",
          "requires": [
            "mustFixOpenZero"
          ],
          "executor": "dev-flow-v6 D4",
          "actor": "builder"
        },
        {
          "from": "implementation-recorded",
          "to": "assuring",
          "event": "assurance-start",
          "requires": [],
          "executor": "independent-assurance-v6 --mode full",
          "actor": "assurance"
        },
        {
          "from": "assuring",
          "to": "finalizing",
          "event": "AssuranceCompleted",
          "requires": [
            "assuranceCompleted"
          ],
          "executor": "independent-assurance-v6",
          "actor": "assurance"
        },
        {
          "from": "assuring",
          "to": "repairing",
          "event": "repair-start",
          "requires": [
            "openMustFixPositive",
            "budgetPerVersionAvailable",
            "budgetCrossRunAvailable"
          ],
          "executor": "assurance-repair-loop-v6",
          "actor": "builder"
        },
        {
          "from": "repairing",
          "to": "assuring",
          "event": "RepairRoundRecorded",
          "requires": [
            "budgetPerVersionAvailable",
            "budgetCrossRunAvailable"
          ],
          "executor": "assurance-repair-loop-v6",
          "actor": "builder",
          "backedge": "repair"
        },
        {
          "from": "finalizing",
          "to": "assuring",
          "event": "RepairRoundRecorded",
          "requires": [
            "budgetPerVersionAvailable",
            "budgetCrossRunAvailable"
          ],
          "executor": "assurance-repair-loop-v6",
          "actor": "builder",
          "backedge": "repair",
          "note": "跨 run 修复循环（历史任务回放发现）：真实事件序 = AssuranceCompleted 落盘后才发现修复需求，RepairRoundRecorded 从 finalizing 回 assuring 再 recheck——缺此边则回放不可表达"
        },
        {
          "from": "finalizing",
          "to": "candidate",
          "event": "evaluate",
          "requires": [],
          "executor": "delivery-gate evaluate",
          "actor": "main-agent"
        },
        {
          "from": "candidate",
          "to": "accepted",
          "event": "evaluate",
          "requires": [
            "verdictAccepted"
          ],
          "executor": "delivery-gate evaluate",
          "actor": "main-agent"
        },
        {
          "from": "candidate",
          "to": "accepted_with_risk",
          "event": "accept-risk",
          "requires": [
            "userRiskAcceptance"
          ],
          "executor": "delivery-gate accept-risk",
          "actor": "user"
        },
        {
          "from": "revision-unstable",
          "to": "implementing",
          "event": "RevisionBaselineConfirmed",
          "requires": [
            "baselineConfirmed"
          ],
          "executor": "delivery-gate confirm-baseline",
          "actor": "user",
          "backedge": "repair"
        },
        {
          "from": "*",
          "to": "revision-unstable",
          "event": "drift-detected",
          "requires": [
            "driftDetected"
          ],
          "executor": "delivery-gate evaluate",
          "actor": "engine"
        },
        {
          "from": "*",
          "to": "process-failed",
          "event": "budget-exhausted",
          "requires": [
            "uniqueMustFixCapExceeded"
          ],
          "executor": "delivery-gate evaluate",
          "actor": "engine",
          "note": "含 perVersion>3 / uniqueMustFix>10 / 跨 run 保证>6 / 验收复审 started>6 四档预算耗尽，停回用户（判定在 gate evaluate，谓词只是模型层表达）"
        },
        {
          "from": "*",
          "to": "supersede-pending",
          "event": "supersede-prepare",
          "requires": [
            "userConfirmation"
          ],
          "executor": "delivery-gate supersede-prepare",
          "actor": "user"
        },
        {
          "from": "supersede-pending",
          "to": "superseded",
          "event": "supersede-commit",
          "requires": [
            "userConfirmation"
          ],
          "executor": "delivery-gate supersede-commit",
          "actor": "user"
        },
        {
          "from": "supersede-pending",
          "to": "supersede-cancelled",
          "event": "supersede-cancel",
          "requires": [
            "userConfirmation"
          ],
          "executor": "delivery-gate supersede-cancel",
          "actor": "user"
        }
      ]
    },
    "node": {
      "initial": "pending",
      "states": [
        "pending",
        "in-progress",
        "done",
        "blocked",
        "failed",
        "suspended"
      ],
      "terminalStates": [],
      "transitions": [
        {
          "from": "pending",
          "to": "in-progress",
          "event": "begin",
          "requires": [],
          "executor": "wave-executor-v6",
          "actor": "engine",
          "effect": "attempts+1（派发即计数；V4 缺陷修复：begin 原地归零使修复环保留的计数丢失）"
        },
        {
          "from": "in-progress",
          "to": "done",
          "event": "finish-done",
          "requires": [
            "commitReceipt"
          ],
          "executor": "wave-executor-v6",
          "actor": "engine",
          "effect": "attempts 保留（下限 1）"
        },
        {
          "from": "in-progress",
          "to": "blocked",
          "event": "block",
          "requires": [
            "reasonProvided"
          ],
          "executor": "wave-executor-v6",
          "actor": "engine",
          "effect": "attempts 保留（begin 已计数）"
        },
        {
          "from": "in-progress",
          "to": "failed",
          "event": "fail",
          "requires": [
            "reasonProvided"
          ],
          "executor": "wave-executor-v6",
          "actor": "engine",
          "effect": "attempts 保留（begin 已计数）"
        },
        {
          "from": "blocked",
          "to": "pending",
          "event": "reset",
          "requires": [],
          "executor": "wave-executor-v6 失败修复环",
          "actor": "engine",
          "backedge": "repair",
          "effect": "attempts 保留（下一次 begin 再 +1；V4 在此 +1 且 begin 归零 = 双写竞争）"
        },
        {
          "from": "failed",
          "to": "pending",
          "event": "reset",
          "requires": [],
          "executor": "wave-executor-v6 失败修复环",
          "actor": "engine",
          "backedge": "repair",
          "effect": "attempts 保留（下一次 begin 再 +1；V4 在此 +1 且 begin 归零 = 双写竞争）"
        },
        {
          "from": "pending",
          "to": "suspended",
          "event": "suspend",
          "requires": [],
          "executor": "wave-executor-v6 终局回写",
          "actor": "engine",
          "effect": "attempts 保留"
        },
        {
          "from": "suspended",
          "to": "pending",
          "event": "resume",
          "requires": [],
          "executor": "wave-executor-v6 断点恢复",
          "actor": "engine",
          "backedge": "lifecycle"
        },
        {
          "from": "done",
          "to": "pending",
          "event": "reconcile-pending",
          "requires": [],
          "executor": "wave-executor-v6 恢复对账",
          "actor": "engine",
          "note": "标 done 无 commit → 以 git 为准回退",
          "backedge": "repair",
          "effect": "attempts 保留（V4 缺陷修复：原归零丢计数）"
        },
        {
          "from": "pending",
          "to": "done",
          "event": "reconcile-done",
          "requires": [
            "commitReceipt"
          ],
          "executor": "wave-executor-v6 恢复对账",
          "actor": "engine",
          "note": "git log 反查命中补写",
          "effect": "attempts = max(1, prior+1)（补记 git 中发现的一次未记账完成派发）"
        },
        {
          "from": "in-progress",
          "to": "pending",
          "event": "cascade-reset",
          "requires": [],
          "executor": "wave-executor-v6",
