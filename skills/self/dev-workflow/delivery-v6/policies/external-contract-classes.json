{
  "_comment": "schemaVersion 是登记性字段（当前零消费方——策略升级按快照哈希差判定，不读本键）；保留作文件格式演进预留位，修改不改变机器行为。classes 由候选探测线消费（detect-external-contracts 匹配源），词表变更走 upgrade-policy。",
  "schemaVersion": 1,
  "classes": [
    {
      "id": "extension-entrypoint",
      "description": "外部系统装载扩展/插件的入口点：宿主 manifest 声明的入口文件，或该文件中的默认导出工厂形态",
      "staticSignals": [
        { "kind": "manifest-field", "field": "pi.extensions", "note": "宿主插件清单字段：声明本包是某外部系统的扩展" },
        { "kind": "regex", "pattern": "export\\s+default\\s+(?:async\\s+)?(?:function\\b|\\()", "appliesTo": "source", "note": "默认导出工厂/入口形态" }
      ],
      "minEnvironment": "official-runner",
      "impliesObservationClasses": []
    },
    {
      "id": "register-tool",
      "description": "向外部宿主注册工具或可调用能力入口的调用点",
      "staticSignals": [
        { "kind": "regex", "pattern": "\\.\\s*registerTool\\s*\\(", "appliesTo": "source" },
        { "kind": "regex", "pattern": "\\.\\s*addTool\\s*\\(", "appliesTo": "source" }
      ],
      "minEnvironment": "official-runner",
      "impliesObservationClasses": []
    },
    {
      "id": "invoke-tool",
      "description": "按宿主签名调用已注册工具并消费宿主返回对象的调用点",
      "staticSignals": [
        { "kind": "regex", "pattern": "\\.\\s*invokeTool\\s*\\(", "appliesTo": "source" },
        { "kind": "regex", "pattern": "\\.\\s*callTool\\s*\\(", "appliesTo": "source" },
        { "kind": "regex", "pattern": "\\.\\s*executeTool\\s*\\(", "appliesTo": "source" }
      ],
      "minEnvironment": "official-runner",
      "impliesObservationClasses": []
    },
    {
      "id": "register-command",
      "description": "向外部宿主注册命令或斜杠命令的调用点；注册必须伴随真实分发观察（蕴含 dispatch-command）",
      "staticSignals": [
        { "kind": "regex", "pattern": "\\.\\s*registerCommand\\s*\\(", "appliesTo": "source" },
        { "kind": "regex", "pattern": "\\.\\s*addCommand\\s*\\(", "appliesTo": "source" },
        { "kind": "regex", "pattern": "\\.\\s*registerSlashCommand\\s*\\(", "appliesTo": "source" }
      ],
      "minEnvironment": "official-runner",
      "impliesObservationClasses": ["dispatch-command"]
    },
    {
      "id": "dispatch-command",
      "description": "用户输入经真实宿主命令解析规则命中注册命令的分发路径；涉及完整用户交互，最低环境为 real-host",
      "staticSignals": [
        { "kind": "regex", "pattern": "\\.\\s*dispatchCommand\\s*\\(", "appliesTo": "source" },
        { "kind": "regex", "pattern": "\\.\\s*handleCommand\\s*\\(", "appliesTo": "source" },
        { "kind": "regex", "pattern": "commandRegistry\\b", "appliesTo": "source" }
      ],
      "minEnvironment": "real-host",
      "impliesObservationClasses": []
    },
    {
      "id": "context-event",
      "description": "订阅或发出上下文/事件流改写的调用点",
      "staticSignals": [
        { "kind": "regex", "pattern": "\\.\\s*on\\s*\\(\\s*[\"'`]context[\"'`]", "appliesTo": "source" },
        { "kind": "regex", "pattern": "contextEvent\\b", "appliesTo": "source" },
        { "kind": "regex", "pattern": "emitContext\\b", "appliesTo": "source" }
      ],
      "minEnvironment": "official-runner",
      "impliesObservationClasses": []
    },
    {
      "id": "model-call",
      "description": "经外部模型注册表或补全入口调用模型的调用点",
      "staticSignals": [
        { "kind": "regex", "pattern": "modelRegistry\\b", "appliesTo": "source" },
        { "kind": "regex", "pattern": "chatCompletion\\s*\\(", "appliesTo": "source" },
        { "kind": "regex", "pattern": "\\.\\s*generateText\\s*\\(", "appliesTo": "source" }
      ],
      "minEnvironment": "official-runner",
      "impliesObservationClasses": []
    }
  ]
}
